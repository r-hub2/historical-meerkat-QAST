d$t <- rexp(n, rate = exp(-0.3 * d$trt))
d$status <- rbinom(n, 1, 0.8)
d$qt <- d$t * runif(n, 0.5, 1)
fit <- semi_aft_prop(Qsurv(t, qt, status) ~ age + trt, data = d)

