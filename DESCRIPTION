Package: QAST
Title: Joint Regression Analysis of Survival and Quality-Adjusted
        Survival
Version: 0.1.0
Authors@R: c(
    person("Alan", "da Silva", email = "alansilva@alumni.usp.br",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-9674-9830")),
    person("Gisela", "Tunes da Silva", role = "aut",
           comment = c(ORCID = "0000-0003-3088-3134")),
